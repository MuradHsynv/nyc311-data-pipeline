# Copy this file to .env and fill in real values. NEVER commit .env.
# Placeholders only below: no real secrets belong in this file.

# --- PostgreSQL ---
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=change_me
POSTGRES_DB=nyc311
POSTGRES_HOST=postgres        # use 'localhost' when running tests on your own machine
POSTGRES_PORT=5432

# --- Socrata (NYC Open Data) ---
SOCRATA_APP_TOKEN=            # free token from data.cityofnewyork.us, raises rate limits
SOCRATA_DATASET_ID=erm2-nwe9
SOCRATA_PAGE_SIZE=5000

# --- Pipeline behavior ---
QUALITY_FAIL_THRESHOLD=0.05   # fail the run if more than 5% of records are invalid
INITIAL_LOOKBACK_DAYS=30      # first incremental run looks back this many days
SCHEDULE_CRON=0 3 * * *       # scheduler runs daily at 03:00
LOG_LEVEL=INFO
